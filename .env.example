# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#
# OpenAI (agent and judge)
OPENAI_API_KEY=
# Models: Luna-class agent, Sol-class judge (pinned defaults, verified working).
AGENT_MODEL=gpt-6-luna
JUDGE_MODEL=gpt-6.1-sol

# LangSmith (tracing + evaluation)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=windmill-bank-agent
# Uncomment only if the account has multiple workspaces:
# LANGSMITH_WORKSPACE_ID=
